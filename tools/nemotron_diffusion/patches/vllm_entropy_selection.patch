+@requires_gpu
+def test_entropy_budget_selection():
+    """Gemma prefix bound, absorbing/padding masks, sampling and temperature."""
+    from vllm.model_executor.models.nemotron_dllm import _compiled_masked_step
+
+    device = "cuda"
+    batch, width, vocab, mask_id = 2048, 6, 3, 2
+    # Position 4 is already revealed; position 5 is padding. Both very certain.
+    probs = torch.tensor([.999, .99, .95, .5, .9999, .99999], device=device)
+    logits = torch.stack(
+        (probs.log(), (1-probs).log(), torch.full_like(probs, -80)), -1
+    )
+    logits = logits.expand(batch, -1, -1).contiguous()
+    slots = torch.arange(batch, device=device)
+    for temperature in (1.0, 0.6):
+        lp_ref = (logits[0] / temperature).log_softmax(-1)
+        h = -(lp_ref.exp()*lp_ref).sum(-1)
+        for budget in (0.0, 0.1, 10.0):
+            canvas = torch.full(
+                (batch, width), mask_id, device=device, dtype=torch.int64
+            )
+            canvas[:, 4] = 1
+            step = torch.zeros(batch, device=device, dtype=torch.int32)
+            phase = torch.zeros(batch, device=device, dtype=torch.bool)
+            lp = torch.zeros(batch, width, device=device)
+            rank = torch.zeros_like(canvas, dtype=torch.int32)
+            ent = torch.zeros_like(lp)
+            reveal = torch.full_like(rank, -1)
+            sampled = torch.zeros_like(rank)
+            count = torch.zeros_like(step)
+            draft = torch.zeros_like(canvas)
+            output_reveal = torch.zeros_like(rank)
+            torch.manual_seed(783)
+            _compiled_masked_step(
+                logits.reshape(-1, vocab), slots, slots, slots,
+                torch.full_like(slots, 5), torch.ones(batch, device=device),
+                canvas, step, phase, lp, rank, ent, reveal,
+                sampled, count, draft, output_reveal,
+                max_denoising_steps=width, mask_token_id=mask_id, CL=width,
+                temperature=temperature, capture_logprobs=True,
+                capture_entropy=True, capture_steps=True, leftmost=False,
+                random_mode=False, threshold_mode=False, log_threshold=math.log(.9),
+                entropy_budget_mode=True, entropy_bound=budget,
+            )
+            # Independent scalar definition, rather than the vectorized implementation.
+            ordered = sorted(range(4), key=lambda j: float(h[j]))
+            chosen = []
+            for j in ordered:
+                candidate = chosen + [j]
+                hs = [float(h[t]) for t in candidate]
+                if sum(hs) - max(hs) <= budget:
+                    chosen = candidate
+                else:
+                    break
+            expected = torch.zeros(width, device=device, dtype=torch.bool)
+            expected[chosen] = True
+            assert (reveal.eq(0) == expected[None]).all()
+            assert canvas[:, 4].eq(1).all() and canvas[:, 5].eq(mask_id).all()
+            if budget == 0:
+                assert len(chosen) == 1
+            if budget == .1 and temperature == 1:
+                assert len(chosen) == 3  # naive sum(H) would only select two
+            if budget == 10:
+                assert len(chosen) == 4
+            for j in chosen:
+                want = lp_ref[j].gather(0, canvas[:, j])
+                torch.testing.assert_close(lp[:, j], want)
+                torch.testing.assert_close(ent[:, j], h[j].expand(batch))
+                fraction = canvas[:, j].eq(1).float().mean().item()
+                assert abs(fraction - float(lp_ref[j, 1].exp())) < .035
