+@requires_gpu
+def test_entropy_selection_preserves_low_probability_candidates():
+    """Rank distributions independently of draws; preserve sampled-token logprobs."""
+    from vllm.model_executor.models.nemotron_dllm import _compiled_masked_step
+
+    device = "cuda"
+    batch, width, vocab, mask_id = 2048, 4, 5, 4
+    probs = torch.tensor(
+        [[0.9, 0.1], [0.8, 0.2], [0.7, 0.3], [0.999, 0.001]], device=device
+    )
+    logits = torch.full((batch, width, vocab), -80.0, device=device)
+    logits[:, :, :2] = probs.log()
+    slots = torch.arange(batch, device=device)
+
+    def run(entropy_mode, temperature=1.0, steps=2):
+        canvas = torch.full((batch, width), mask_id, device=device, dtype=torch.int64)
+        step = torch.zeros(batch, device=device, dtype=torch.int32)
+        phase = torch.zeros(batch, device=device, dtype=torch.bool)
+        lp = torch.zeros(batch, width, device=device)
+        rank = torch.zeros_like(canvas, dtype=torch.int32)
+        ent = torch.zeros_like(lp)
+        reveal = torch.full_like(rank, -1)
+        sampled = torch.zeros_like(rank)
+        count = torch.zeros_like(step)
+        draft = torch.zeros_like(canvas)
+        output_reveal = torch.zeros_like(rank)
+        for _ in range(steps):
+            _compiled_masked_step(
+                logits.reshape(-1, vocab), slots, slots, slots,
+                torch.full_like(slots, 3), torch.ones(batch, device=device),
+                canvas, step, phase, lp, rank, ent, reveal,
+                sampled, count, draft, output_reveal,
+                max_denoising_steps=2, mask_token_id=mask_id, CL=width,
+                temperature=temperature, capture_logprobs=True,
+                capture_entropy=True, capture_steps=True, leftmost=False,
+                random_mode=False, threshold_mode=False,
+                log_threshold=math.log(0.9), entropy_mode=entropy_mode,
+            )
+        return canvas, lp, reveal
+
+    torch.manual_seed(192)
+    canvas, lp, reveal = run(True, steps=1)
+    assert (canvas[:, :2] != mask_id).all()
+    assert (canvas[:, 2:] == mask_id).all()  # third masked; fourth is invalid padding
+    for pos, expected in [(0, 0.1), (1, 0.2)]:
+        fraction = (canvas[:, pos] == 1).float().mean().item()
+        assert abs(fraction - expected) < 0.035
+    expected_lp = probs[:2].log().expand(batch, -1, -1).gather(
+        -1, canvas[:, :2].unsqueeze(-1)
+    ).squeeze(-1)
+    torch.testing.assert_close(lp[:, :2], expected_lp)
+    assert (reveal[:, :2] == 0).all()
+    assert (reveal[:, 2:] == -1).all()
+
+    torch.manual_seed(192)
+    confidence_canvas, _, _ = run(False, steps=1)
+    assert (confidence_canvas[:, 2] != mask_id).any()
+    assert (confidence_canvas[:, :3] != mask_id).sum(1).eq(2).all()
+
+    for temperature in (0.0, 0.6, 1.0):
+        canvas, _, reveal = run(True, temperature=temperature)
+        assert (canvas[:, :3] != mask_id).all()
+        assert (canvas[:, 3] == mask_id).all()
+        assert (reveal[:, :2] == 0).all()
+        assert (reveal[:, 2] == 1).all()


