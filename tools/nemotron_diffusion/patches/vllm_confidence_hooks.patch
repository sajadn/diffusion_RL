+def test_confidence_hook_activation_is_explicit_and_independent(monkeypatch):
+    from types import SimpleNamespace
+    import builtins
+    from vllm.model_executor.models.nemotron_dllm import _load_confidence_hooks
+
+    monkeypatch.setenv("NRL_CONFIDENCE_EXPERIMENT_DIR", "/stale/experiment")
+    monkeypatch.setenv("NRL_CONFIDENCE_AUDIT_DIR", "/stale/audit")
+    experiment, audit = SimpleNamespace(), SimpleNamespace()
+    imported = []
+    original_import = builtins.__import__
+
+    def import_hook(name, *args, **kwargs):
+        if name in ("confidence_experiment", "confidence_audit_hooks"):
+            imported.append(name)
+            return experiment if name == "confidence_experiment" else audit
+        return original_import(name, *args, **kwargs)
+
+    monkeypatch.setattr(builtins, "__import__", import_hook)
+    assert _load_confidence_hooks(False, False) == (None, None)
+    assert imported == []
+    assert _load_confidence_hooks(False, True) == (None, audit)
+    assert imported == ["confidence_audit_hooks"]
+    assert _load_confidence_hooks(True, False) == (experiment, None)
+    assert imported == ["confidence_audit_hooks", "confidence_experiment"]
+    monkeypatch.delenv("NRL_CONFIDENCE_EXPERIMENT_DIR")
+    with pytest.raises(ValueError, match="NRL_CONFIDENCE_EXPERIMENT_DIR"):
+        _load_confidence_hooks(True, False)
+
+
+def test_confidence_capture_skips_validation_policy_switches_and_greedy_rows():
+    from types import SimpleNamespace
+    from vllm.model_executor.models.nemotron_dllm import MaskedDiffusionSampler
+
+    calls = []
+    def before(sampler, slots, skip):
+        calls.append(skip.clone())
+        return "capture"
+
+    sampler = SimpleNamespace(
+        _confidence_experiment=SimpleNamespace(before_sample=before),
+        _confidence_audit=None, threshold_mode=True, temperature=1.0,
+        log_threshold=math.log(.9), canvas_length=16, mask_token_id=100,
+    )
+    capture = MaskedDiffusionSampler._capture_confidence_contexts
+    slots = torch.arange(3)
+    committing = torch.tensor([False, False, True])
+    req_temps = torch.tensor([1., 0., 1.])
+    assert capture(sampler, slots, committing, req_temps) == ("capture", None)
+    torch.testing.assert_close(calls[0], torch.tensor([False, True, True]))
+    for field, value in [("threshold_mode", False), ("temperature", .6), ("log_threshold", math.log(.8))]:
+        previous = getattr(sampler, field)
+        setattr(sampler, field, value)
+        assert capture(sampler, slots, committing, req_temps) == (None, None)
+        assert len(calls) == 1
+        setattr(sampler, field, previous)
+    sampler._confidence_experiment = None
+    assert capture(sampler, slots, committing, req_temps) == (None, None)
